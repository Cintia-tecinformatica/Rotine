DATABASE_URL="mysql://usuario:senha@localhost:3306/meu_projeto_db"

DATABASE_HOST="endereço do servidor onde está seu banco de dados"
DATABASE_PORT="porta de comunicação"
DATABASE_USER="seu usuário"
DATABASE_PASSWORD="senha do seu banco de dados"
DATABASE_NAME="nome do banco de dados"

JWT_SECRET="chave criptografada usada pelo servidor para assinar e verfificar a intregidade de um JWT"